# Game data: your own copy of Quake 4 stays on your machine. Never commit it.
/game_data/
*.pk4
*.iso
*.exe
*.dll
*.so
*.dylib

# Local notes and upstream clones
/Quake4NX Documentation.txt
/.upstream/

# Build output
/build/
/build-*/
/build_*/
*.nro
*.nacp
*.elf
*.nso
*.npdm
*.dksh
*.map
!/src/**/*.map

# SD card image and console logs: kept as folders, filled locally
/SD_CARD/*
!/SD_CARD/README.md
/SD_LOG/*
!/SD_LOG/README.md

# Host files
.DS_Store
Thumbs.db
__pycache__/
.vscode/
.claude/
